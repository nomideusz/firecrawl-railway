# Firecrawl's self-hosted API has no auth of its own, so the gateway asks for
# the key the Firecrawl SDKs, MCP server and n8n node already send:
# Authorization: Bearer <FIRECRAWL_API_KEY>.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Railway's healthcheck: answered here, so it needs no key.
	handle /railway-health {
		respond "ok" 200
	}

	# Bull queue dashboard: a browser can't send the header, the key is in the path.
	handle /admin/{$BULL_AUTH_KEY}/* {
		reverse_proxy {$FIRECRAWL_UPSTREAM}
	}

	@authed header Authorization "Bearer {$FIRECRAWL_API_KEY}"
	handle @authed {
		reverse_proxy {$FIRECRAWL_UPSTREAM} {
			# Crawls and extracts can hold a request open for minutes.
			transport http {
				read_timeout 10m
			}
		}
	}

	handle {
		header Content-Type application/json
		respond `{"success":false,"error":"Unauthorized: send Authorization: Bearer <FIRECRAWL_API_KEY>"}` 401
	}
}
